# Local credentials used by scripts/use-model.sh. Copy this to .env.model-profiles
# (or run one of the `make save-…` commands). This file is intentionally ignored by Git.
#
# The active provider is written to .env. Keep only one model mode active at a time:
# ChatGPT Plan, Claude Plan, OpenCode Go, or an OpenAI API key.

# Output of `claude setup-token` for the Claude Plan mode.
CLAUDE_CODE_OAUTH_TOKEN=

# OpenCode Go is OpenAI-compatible and uses an API key from its console, not OAuth.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=kimi-k3
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Optional fallback for direct use of the OpenAI API.
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_BASE_URL=
